# Editors and IDEs
# ------------------------------------------------------------
.vscode/
.idea/
*.iml
*.ipr
*.iws
*.swp
.history/

# ------------------------------------------------------------
# Python and Jupyter
# ------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/

# ------------------------------------------------------------
# Flutter and Dart
# ------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
**/doc/api/
**/ios/Flutter/.last_build_id
.widget_preview/
app.*.symbols
app.*.map.json

# ------------------------------------------------------------
# Android, Gradle and Kotlin
# ------------------------------------------------------------
.gradle/
.kotlin/
.cxx/
local.properties
captures/
GeneratedPluginRegistrant.java

